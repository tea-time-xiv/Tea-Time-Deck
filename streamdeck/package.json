{
  "name": "tea-time-deck-streamdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck half of TeaTimeDeck. Talks to the FFXIV Dalamud plugin.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "streamdeck pack xiv.teatime.deck.sdPlugin --output ../dist --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.0",
    "@elgato/utils": "^0.4.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@elgato/cli": "^1.7.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "@types/node": "^20.17.6",
    "@types/ws": "^8.5.13",
    "rollup": "^4.27.2",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
